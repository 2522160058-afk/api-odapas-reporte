                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta con estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve 3 reportes\", () => pm.expect(pm.response.json().length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar reportes por tipo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{urlBase}}/api/reportes?tipo=fuga",
              "host": [
                "{{urlBase}}"
              ],
              "path": [
                "api",
                "reportes"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "fuga"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta con estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Solo reportes de fuga\", () => pm.response.json().forEach(r => pm.expect(r.tipo).to.eql(\"fuga\")));"
                ]
              }
            }
          ]
        },
